{
  "name": "mufka",
  "productName": "Mufka",
  "version": "1.5.1",
  "description": "Personal planner and Markdown notes for macOS and Windows: a week planner, an Obsidian-like vault and a graph of your notes.",
  "author": "Batuhan Baş",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "test": "node --test test/*.test.mjs && npm run build && npm run e2e",
    "e2e": "electron test/e2e.js",
    "smoke:packaged": "npm run build && electron scripts/packaged-hook-smoke.js",
    "dist": "electron-vite build && electron-builder",
    "dist:public": "electron-vite build && MUFKA_SIGN_IDENTITY=- electron-builder",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "sign:dev": "node scripts/sign-mac.mjs node_modules/electron/dist/Electron.app"
  },
  "build": {
    "appId": "com.mufka.app",
    "productName": "Mufka",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Mufka keeps your notes as Markdown files in Documents/Mufka."
      }
    },
    "dmg": {
      "title": "Mufka"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Mufka",
      "artifactName": "Mufka-${version}-Setup.${ext}"
    },
    "files": [
      "out/**/*",
      "build/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "copyright": "Copyright © 2026 Batuhan Baş"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.7"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/batuhan-bas/mufka.git"
  }
}
